{
  email you@yourdomain.com
  acme_ca https://acme-v02.api.letsencrypt.org/directory
}

# ── Reusable app routing snippet (must be in parentheses) ─────────
(app_routing) {
  @api_ws {
    path /api/* /socket.io* /ws* /socket.io/*
  }
  reverse_proxy @api_ws app:5000
  reverse_proxy /* frontend:80

  encode gzip
  header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
}

# ── Force HTTP → HTTPS for all three web hosts ────────────────────
http://tasknitter.com, http://www.tasknitter.com, http://app.tasknitter.com {
  redir https://{host}{uri} permanent
}

# ── Redirect root & www → app (single origin for CORS) ────────────
tasknitter.com, www.tasknitter.com {
  redir https://app.tasknitter.com{uri} permanent
}

# ── Main SaaS: app subdomain (API+WS → backend; SPA → frontend) ──
app.tasknitter.com {
  import app_routing
}

# ── MQTT over secure WebSockets (TLS via Caddy) ───────────────────
mqtt.tasknitter.com {
  reverse_proxy mosquitto:9001
  header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  encode gzip
}
