# ───────────────────────────────────────────────────────────────────────────
# 1) Build stage: produce optimized React static bundle
# ───────────────────────────────────────────────────────────────────────────
FROM node:18 AS builder
WORKDIR /app

# Accept build-time values
ARG REACT_APP_API_BASE_URL
ARG REACT_APP_SOCKET_URL
ARG REACT_APP_MQTT_WS_URL

# Expose them to the build (CRA reads process.env)
ENV REACT_APP_API_BASE_URL=${REACT_APP_API_BASE_URL}
ENV REACT_APP_SOCKET_URL=${REACT_APP_SOCKET_URL}
ENV REACT_APP_MQTT_WS_URL=${REACT_APP_MQTT_WS_URL}

COPY package*.json ./
RUN npm ci

COPY .env ./.env
COPY . .
RUN npm run build

# ───────────────────────────────────────────────────────────────────────────
# 2) Serve stage: copy build into Caddy
# ───────────────────────────────────────────────────────────────────────────
FROM caddy:2-alpine

# Caddyfile for serving the SPA
COPY Caddyfile.frontend /etc/caddy/Caddyfile

# Static files from React build
COPY --from=builder /app/build /srv

# expose container port 80 (internal only)
EXPOSE 80
